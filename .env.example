
CONFIG_PATH = "config/config.yaml"

# Timeout for requests in seconds
TIMEOUT = 30

# Do increase timeout and how much when asking failed
TIMEOUT_INCREASE = 15
DO_INCREASE_TIMEOUT_AFTER_FAIL = true

# How many times increase timeout
TIMEOUT_MAX_INCREASE_TIMES = 5

SN_API_KEY = "<api-key>"
SN_INSTANCE_URL = "<instance-url>"
SN_API_URL = "<api-url>"

SN_API_KEY_HEADER_NAME = "SN-API_KEY"

